# Server-only. Loopmuse uses public Moodies tables for live mode and moodies_test for test mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Random secret of at least 32 characters; preserve it across deployments.
ORDER_TOKEN_SECRET=
# Explicit account mode, prevents test/live cross-contamination.
COMMERCE_LIVE_MODE=false
COMMERCE_CURRENCY=usd
# Public URLs, no trailing slash. ORDER_BASE_URL is this backend's origin.
STOREFRONT_URL=http://localhost:3000
ORDER_BASE_URL=http://localhost:3000
# Exact allowed browser origins, comma-separated; no wildcard.
CHECKOUT_ALLOWED_ORIGINS=http://localhost:3000
SHIPPING_ALLOWED_COUNTRIES=US
# Free shipping on every order, as requested. No paid rate is needed at threshold 0.
STRIPE_FLAT_SHIPPING_RATE_ID=
# Required: active zero-dollar Stripe Shipping Rate of the same account/mode/currency.
STRIPE_FREE_SHIPPING_RATE_ID=
FREE_SHIPPING_THRESHOLD_MINOR=0
STRIPE_AUTOMATIC_TAX=false
STRIPE_ALLOW_PROMOTION_CODES=true
# Used only by catalog:seed. Read inventory from physical stock; no guessed counts.
MOODIES_RAINBOW_PRICE_ID=
MOODIES_RAINBOW_INVENTORY=
